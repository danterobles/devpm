NODE_ENV=development
PORT=3000
DATABASE_PATH=data/devpm.db
# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
TZ_APP=America/Mexico_City
LOG_LEVEL=info
LOGIN_MAX_ATTEMPTS=10
BACKUP_RETENTION_DAYS=14
# Carpeta de los respaldos (npm run db:backup)
BACKUP_DIR=data/backups

# Notificaciones por correo (opcional). Sin SMTP_HOST solo hay avisos dentro de la aplicación.
# URL pública de la aplicación, para los enlaces de los correos
APP_URL=http://localhost:3000
#SMTP_HOST=smtp.ejemplo.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=DevPM <no-reply@ejemplo.com>
#SMTP_SECURE=false
