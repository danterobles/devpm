NODE_ENV=development
PORT=3000
DATABASE_PATH=data/devpm.db
# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
TZ_APP=America/Mexico_City
LOG_LEVEL=info
LOGIN_MAX_ATTEMPTS=10
BACKUP_RETENTION_DAYS=14
# Carpeta de los respaldos (npm run db:backup)
BACKUP_DIR=data/backups
