{
  "name": "devpm",
  "version": "0.5.0",
  "description": "DevPM - Gestión de proyectos de desarrollo de software con KPIs en tiempo real",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently -k -n srv,css \"node --watch --env-file-if-exists=.env src/server.js\" \"npm:watch:css\"",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build:css": "tailwindcss -i src/styles/input.css -o public/css/output.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o public/css/output.css --watch",
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/modules/**/*.service.js\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "node --env-file-if-exists=.env src/db/cli.js migrate",
    "db:seed": "node --env-file-if-exists=.env src/db/cli.js seed",
    "db:reset": "node --env-file-if-exists=.env src/db/cli.js reset",
    "test:perf": "node --test --test-reporter=spec \"tests/perf/*.perf.js\"",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.js",
    "user:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "health": "node scripts/healthcheck.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.6.1",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "frappe-gantt": "^1.2.2",
    "helmet": "^8.3.0",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.5"
  }
}
