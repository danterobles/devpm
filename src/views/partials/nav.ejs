<header class="bg-brand-700 text-white">
  <nav class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3" aria-label="Principal">
    <a href="/" class="text-lg font-semibold"><%= appName %></a>
    <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/">Inicio</a></li>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/dashboard">Tablero</a></li>
      <% } %>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/clients">Clientes</a></li>
        <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/team">Equipo</a></li>
        <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/projects">Proyectos</a></li>
        <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/gantt">Portafolio</a></li>
        <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/assignments/load">Carga</a></li>
        <% if (currentUser.role !== 'viewer') { %><li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/time">Tiempo</a></li><% } %>
      <% } %>
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
        <li><a class="hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" href="/admin/users">Usuarios</a></li>
      <% } %>
    </ul>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <form method="post" action="/logout" class="ml-auto flex items-center gap-3 text-sm">
        <a href="/account/password" class="underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white"><%= currentUser.fullName %></a>
        <button type="submit" class="underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-white">Salir</button>
      </form>
    <% } %>
  </nav>
</header>
