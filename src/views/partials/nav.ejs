<%
  const user = typeof currentUser !== 'undefined' ? currentUser : null;
  const path = typeof currentPath !== 'undefined' ? currentPath : '';
  // [etiqueta, ruta, prefijos que la marcan como activa, trazo del icono]
  const items = [['Inicio', '/', [], 'M3 11l9-8 9 8M5 10v10h14V10']];
  if (user) {
    items.push(
      ['Tablero', '/dashboard', ['/dashboard'], 'M3 3h7v9H3zM14 3h7v5h-7zM14 12h7v9h-7zM3 16h7v5H3z'],
      ['Clientes', '/clients', ['/clients'], 'M4 21V5l8-2v18M12 9h8v12M4 21h16M8 9h1M8 13h1M8 17h1'],
      ['Equipo', '/team', ['/team'], 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8'],
      ['Proyectos', '/projects', ['/projects', '/tasks'], 'M3 7h18v13H3zM8 7V4h8v3'],
      ['Portafolio', '/gantt', ['/gantt'], 'M3 5h18v16H3zM3 10h18M8 3v4M16 3v4'],
      ['Carga', '/assignments/load', ['/assignments'], 'M4 20V10M10 20V4M16 20v-7M22 20H2'],
    );
    if (user.role !== 'viewer') items.push(['Tiempo', '/time', ['/time'], 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18M12 7v5l3 2']);
    if (['admin', 'pm'].includes(user.role))
      items.push(['Importar', '/import', ['/import'], 'M12 3v12M7 8l5-5 5 5M4 17v3h16v-3']);
    if (user.role === 'admin') items.push(['Usuarios', '/admin/users', ['/admin'], 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z']);
  }
  const isActive = (href, prefixes) => (href === '/' ? path === '/' : prefixes.some((p) => path === p || path.startsWith(p + '/')));
  const focus = 'focus-visible:outline focus-visible:outline-2 focus-visible:outline-white';
%>
<aside class="bg-navy-900 text-white md:sticky md:top-0 md:h-screen md:w-16 md:shrink-0 dark:md:border-r dark:md:border-white/10">
  <nav class="flex flex-wrap items-start gap-x-1 gap-y-1 px-2 py-2 md:h-full md:flex-col md:flex-nowrap md:justify-start md:gap-2 md:py-4" aria-label="Principal">
    <a href="/" class="mr-2 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sky-300 text-navy-950 md:mb-3 md:mr-0 <%= focus %>" aria-label="<%= appName %>, inicio">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
    </a>
    <ul class="flex flex-1 flex-wrap items-center gap-1 md:flex-none md:flex-col md:gap-2">
      <% items.forEach(([label, href, prefixes, icon]) => { const active = isActive(href, prefixes); %>
        <li>
          <a href="<%= href %>" title="<%= label %>" <%- active ? 'aria-current="page"' : '' %>
             class="flex min-h-11 items-center gap-2 rounded-xl px-3 text-sm font-medium md:h-11 md:w-11 md:justify-center md:p-0 <%= active ? 'bg-white/15 text-white' : 'text-navy-100 hover:bg-white/10 hover:text-white' %> <%= focus %>">
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= icon %>"/></svg>
            <span class="md:sr-only"><%= label %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </nav>
</aside>
