<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Sprints <span class="text-slate-500"><%= project.code %></span></h1>
  <p class="text-sm"><a href="/projects/<%= project.id %>" class="underline">Proyecto</a> · <a href="/projects/<%= project.id %>/backlog" class="underline">Backlog</a> · <a href="/projects/<%= project.id %>/gantt" class="underline">Gantt</a></p>
</div>
<% if (error) { %>
  <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
<% } %>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Sprints del proyecto</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Sprint</th>
        <th scope="col" class="py-2 pr-4">Periodo</th>
        <th scope="col" class="py-2 pr-4">Estado</th>
        <th scope="col" class="py-2 pr-4">Tareas</th>
        <th scope="col" class="py-2 pr-4">Puntos</th>
        <th scope="col" class="py-2"><span class="sr-only">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% sprints.forEach((s) => { %>
        <tr class="border-b align-top">
          <td class="py-2 pr-4"><%= s.name %><% if (s.goal) { %><span class="block text-xs text-slate-500"><%= s.goal %></span><% } %></td>
          <td class="py-2 pr-4"><%= s.startDate %> → <%= s.endDate %></td>
          <td class="py-2 pr-4"><%= s.status %></td>
          <td class="py-2 pr-4"><%= s.taskCount %></td>
          <td class="py-2 pr-4"><%= s.donePoints %> / <%= s.totalPoints %><% if (s.committedPoints !== null) { %> (comprometidos <%= s.committedPoints %>)<% } %></td>
          <td class="py-2">
            <a class="underline" href="/projects/<%= project.id %>/sprints/<%= s.id %>/board">Tablero</a>
            <% if (canWrite && s.status === 'planned') { %>
              <form method="post" action="/projects/<%= project.id %>/sprints/<%= s.id %>/start" class="inline"><button type="submit" class="ml-3 underline">Iniciar</button></form>
              <form method="post" action="/projects/<%= project.id %>/sprints/<%= s.id %>/delete" class="inline"><button type="submit" class="ml-3 underline" aria-label="Eliminar <%= s.name %>">Eliminar</button></form>
            <% } %>
            <% if (canWrite && s.status === 'active') { %>
              <form method="post" action="/projects/<%= project.id %>/sprints/<%= s.id %>/close" class="mt-1 flex items-center gap-2">
                <label for="moveTo<%= s.id %>" class="sr-only">Destino de tareas no terminadas</label>
                <select id="moveTo<%= s.id %>" name="moveTo" class="rounded border border-slate-300 px-2 py-1">
                  <option value="">No terminadas → backlog</option>
                  <% sprints.filter((o) => o.status === 'planned').forEach((o) => { %><option value="<%= o.id %>">No terminadas → <%= o.name %></option><% }) %>
                </select>
                <button type="submit" class="underline">Cerrar sprint</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (sprints.length === 0) { %><tr><td colspan="6" class="py-4 text-slate-600">Este proyecto aún no tiene sprints.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (canWrite) { %>
  <section class="mt-8" aria-labelledby="new-sprint-title">
    <h2 id="new-sprint-title" class="text-xl font-semibold">Nuevo sprint</h2>
    <form method="post" action="/projects/<%= project.id %>/sprints" class="mt-3 flex flex-wrap items-end gap-3">
      <div>
        <label for="spName" class="block text-sm font-medium">Nombre</label>
        <input id="spName" name="name" required maxlength="100" class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="spGoal" class="block text-sm font-medium">Objetivo</label>
        <input id="spGoal" name="goal" maxlength="500" class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="spStart" class="block text-sm font-medium">Inicio</label>
        <input id="spStart" name="startDate" type="date" required class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="spEnd" class="block text-sm font-medium">Fin</label>
        <input id="spEnd" name="endDate" type="date" required class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Crear</button>
    </form>
  </section>
<% } %>
