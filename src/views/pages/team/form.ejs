<% const action = editing ? `/team/${member.id}` : '/team'; %>
<% const field = 'mt-1 w-full rounded border border-slate-300 px-3 py-2'; %>
<% const ro = canWrite ? '' : 'readonly disabled'; %>
<% const v = (key) => (member[key] === null || member[key] === undefined ? '' : member[key]); %>
<section class="mx-auto max-w-lg">
  <h1 class="text-2xl font-bold"><%= title %></h1>
  <% if (error) { %>
    <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
  <% } %>
  <form method="post" action="<%= action %>" class="mt-4 space-y-4">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="firstName" class="block text-sm font-medium">Nombre</label>
        <input id="firstName" name="firstName" required maxlength="80" value="<%= v('firstName') %>" <%= ro %> class="<%= field %>" />
      </div>
      <div>
        <label for="lastName" class="block text-sm font-medium">Apellidos</label>
        <input id="lastName" name="lastName" required maxlength="80" value="<%= v('lastName') %>" <%= ro %> class="<%= field %>" />
      </div>
    </div>
    <div>
      <label for="email" class="block text-sm font-medium">Correo</label>
      <input id="email" name="email" type="email" required maxlength="254" value="<%= v('email') %>" <%= ro %> class="<%= field %>" />
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="position" class="block text-sm font-medium">Puesto</label>
        <select id="position" name="position" <%= ro %> class="<%= field %>">
          <% positions.forEach((p) => { %><option value="<%= p %>" <%= member.position === p ? 'selected' : '' %>><%= p %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="seniority" class="block text-sm font-medium">Seniority</label>
        <select id="seniority" name="seniority" <%= ro %> class="<%= field %>">
          <% seniorities.forEach((s) => { %><option value="<%= s %>" <%= member.seniority === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="weeklyHours" class="block text-sm font-medium">Capacidad semanal (horas)</label>
        <input id="weeklyHours" name="weeklyHours" required inputmode="decimal" pattern="\d+(\.\d{1,2})?" value="<%= v('weeklyHours') %>" <%= ro %> class="<%= field %>" />
      </div>
      <% if (canWrite) { %>
        <div>
          <label for="hourlyCost" class="block text-sm font-medium">Costo por hora</label>
          <input id="hourlyCost" name="hourlyCost" required inputmode="decimal" pattern="\d+(\.\d{1,2})?" value="<%= v('hourlyCost') %>" class="<%= field %>" />
        </div>
      <% } %>
    </div>
    <div>
      <label for="hireDate" class="block text-sm font-medium">Fecha de ingreso</label>
      <input id="hireDate" name="hireDate" type="date" value="<%= v('hireDate') %>" <%= ro %> class="<%= field %>" />
    </div>
    <% if (editing) { %>
      <div class="flex items-center gap-2">
        <input id="isActive" name="isActive" type="checkbox" value="1" <%= member.isActive ? 'checked' : '' %> <%= ro %> />
        <label for="isActive" class="text-sm font-medium">Miembro activo</label>
      </div>
    <% } %>
    <div class="flex gap-3">
      <% if (canWrite) { %>
        <button type="submit" class="rounded bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-700">Guardar</button>
      <% } %>
      <a href="/team" class="rounded border px-4 py-2 hover:bg-slate-100"><%= canWrite ? 'Cancelar' : 'Volver' %></a>
    </div>
  </form>

  <% if (editing) { %>
    <section class="mt-10" aria-labelledby="skills-title">
      <h2 id="skills-title" class="text-xl font-semibold">Habilidades</h2>
      <% if (skillError) { %>
        <p role="alert" class="mt-3 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= skillError %></p>
      <% } %>
      <ul class="mt-3 divide-y text-sm">
        <% skills.forEach((s) => { %>
          <li class="flex items-center justify-between py-2">
            <span><%= s.name %><% if (s.category) { %> <span class="text-slate-500">(<%= s.category %>)</span><% } %> — nivel <%= s.level %>/5</span>
            <% if (canWrite) { %>
              <form method="post" action="/team/<%= member.id %>/skills/<%= s.skillId %>/delete">
                <button type="submit" class="underline" aria-label="Quitar <%= s.name %>">Quitar</button>
              </form>
            <% } %>
          </li>
        <% }) %>
        <% if (skills.length === 0) { %><li class="py-2 text-slate-600">Sin habilidades registradas.</li><% } %>
      </ul>
      <% if (canWrite) { %>
        <form method="post" action="/team/<%= member.id %>/skills" class="mt-4 flex flex-wrap items-end gap-3">
          <div>
            <label for="skillName" class="block text-sm font-medium">Habilidad</label>
            <input id="skillName" name="name" required maxlength="60" class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="skillCategory" class="block text-sm font-medium">Categoría</label>
            <select id="skillCategory" name="category" class="mt-1 rounded border border-slate-300 px-3 py-2">
              <option value="">—</option>
              <% skillCategories.forEach((c) => { %><option value="<%= c %>"><%= c %></option><% }) %>
            </select>
          </div>
          <div>
            <label for="skillLevel" class="block text-sm font-medium">Nivel (1–5)</label>
            <input id="skillLevel" name="level" type="number" min="1" max="5" required class="mt-1 w-20 rounded border border-slate-300 px-3 py-2" />
          </div>
          <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Agregar</button>
        </form>
      <% } %>
    </section>
  <% } %>

  <% if (editing) { %>
    <section class="mt-10" aria-labelledby="timeoff-title">
      <h2 id="timeoff-title" class="text-xl font-semibold">Ausencias</h2>
      <% if (warning === 'time-off-overlap') { %>
        <p role="status" class="mt-3 rounded border border-warn bg-amber-50 px-4 py-3 text-sm text-amber-900">La ausencia se guardó, pero se traslapa con otra del mismo miembro.</p>
      <% } %>
      <% if (timeOffError) { %>
        <p role="alert" class="mt-3 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= timeOffError %></p>
      <% } %>
      <ul class="mt-3 divide-y text-sm">
        <% timeOff.forEach((o) => { %>
          <li class="flex items-center justify-between py-2">
            <span><%= o.type %>: <%= o.startDate %> a <%= o.endDate %> (<%= o.days %> días)<% if (o.notes) { %> — <%= o.notes %><% } %></span>
            <% if (canWrite) { %>
              <form method="post" action="/team/<%= member.id %>/time-off/<%= o.id %>/delete">
                <button type="submit" class="underline" aria-label="Eliminar ausencia del <%= o.startDate %>">Eliminar</button>
              </form>
            <% } %>
          </li>
        <% }) %>
        <% if (timeOff.length === 0) { %><li class="py-2 text-slate-600">Sin ausencias registradas.</li><% } %>
      </ul>
      <% if (canWrite) { %>
        <form method="post" action="/team/<%= member.id %>/time-off" class="mt-4 flex flex-wrap items-end gap-3">
          <div>
            <label for="offType" class="block text-sm font-medium">Tipo</label>
            <select id="offType" name="type" class="mt-1 rounded border border-slate-300 px-3 py-2">
              <% timeOffTypes.forEach((t) => { %><option value="<%= t %>"><%= t %></option><% }) %>
            </select>
          </div>
          <div>
            <label for="offStart" class="block text-sm font-medium">Desde</label>
            <input id="offStart" name="startDate" type="date" required class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="offEnd" class="block text-sm font-medium">Hasta</label>
            <input id="offEnd" name="endDate" type="date" required class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="offNotes" class="block text-sm font-medium">Notas</label>
            <input id="offNotes" name="notes" maxlength="500" class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Agregar</button>
        </form>
      <% } %>
    </section>
  <% } %>
</section>
