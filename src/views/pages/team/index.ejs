<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Equipo</h1>
  <% if (canWrite) { %>
    <a href="/team/new" class="rounded bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Nuevo miembro</a>
  <% } %>
</div>

<form method="get" action="/team" class="mt-4 flex flex-wrap items-end gap-3">
  <div>
    <label for="q" class="block text-sm font-medium">Buscar</label>
    <input id="q" name="q" type="search" value="<%= query.q %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
  </div>
  <div>
    <label for="position" class="block text-sm font-medium">Puesto</label>
    <select id="position" name="position" class="mt-1 rounded border border-slate-300 px-3 py-2">
      <option value="all">Todos</option>
      <% positions.forEach((p) => { %>
        <option value="<%= p %>" <%= query.position === p ? 'selected' : '' %>><%= p %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label for="status" class="block text-sm font-medium">Estado</label>
    <select id="status" name="status" class="mt-1 rounded border border-slate-300 px-3 py-2">
      <% [['all', 'Todos'], ['active', 'Activos'], ['inactive', 'Inactivos']].forEach(([value, label]) => { %>
        <option value="<%= value %>" <%= query.status === value ? 'selected' : '' %>><%= label %></option>
      <% }) %>
    </select>
  </div>
  <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Filtrar</button>
</form>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Miembros del equipo</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Nombre</th>
        <th scope="col" class="py-2 pr-4">Correo</th>
        <th scope="col" class="py-2 pr-4">Puesto</th>
        <th scope="col" class="py-2 pr-4">Seniority</th>
        <th scope="col" class="py-2 pr-4">Horas / semana</th>
        <% if (canWrite) { %><th scope="col" class="py-2 pr-4">Costo / hora</th><% } %>
        <th scope="col" class="py-2 pr-4">Estado</th>
        <th scope="col" class="py-2"><span class="sr-only">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% members.forEach((m) => { %>
        <tr class="border-b">
          <td class="py-2 pr-4"><%= m.fullName %></td>
          <td class="py-2 pr-4"><%= m.email %></td>
          <td class="py-2 pr-4"><%= m.position %></td>
          <td class="py-2 pr-4"><%= m.seniority %></td>
          <td class="py-2 pr-4"><%= minutesToHours(m.weeklyCapacityMinutes) %></td>
          <% if (canWrite) { %><td class="py-2 pr-4"><%= centsToPesos(m.hourlyCostCents) %></td><% } %>
          <td class="py-2 pr-4"><%= m.isActive ? 'Activo' : 'Inactivo' %></td>
          <td class="py-2"><a class="underline" href="/team/<%= m.id %>"><%= canWrite ? 'Editar' : 'Ver' %></a></td>
        </tr>
      <% }) %>
      <% if (members.length === 0) { %>
        <tr><td colspan="8" class="py-4 text-slate-600">No hay miembros que coincidan.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../partials/pagination', { meta, baseUrl }) %>
