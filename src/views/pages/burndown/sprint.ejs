<div class="flex flex-wrap items-center justify-between gap-2">
  <h1 class="text-2xl font-bold">Burndown <span class="text-slate-500"><%= sprint.name %></span></h1>
  <p class="text-sm">
    <a class="underline" href="/projects/<%= project.id %>/sprints/<%= sprint.id %>/board">Tablero</a> ·
    <a class="underline" href="/projects/<%= project.id %>/sprints">Sprints</a> ·
    <a class="underline" href="/projects/<%= project.id %>/gantt">Gantt</a>
  </p>
</div>
<p class="mt-1 text-sm text-slate-600"><%= project.code %> · <%= sprint.startDate %> → <%= sprint.endDate %> · estado: <%= sprint.status %></p>

<div data-burndown data-sprint-id="<%= sprint.id %>" data-live data-live-project="<%= project.id %>" data-live-types="task.,sprint.">
  <p data-live-status class="mt-2 text-xs text-slate-600" role="status" aria-live="polite"></p>
  <div class="mt-4 flex items-center gap-2">
    <label for="burndown-metric" class="text-sm font-medium">Medir en</label>
    <select id="burndown-metric" class="rounded border border-slate-300 px-3 py-1 text-sm">
      <option value="points" selected>Puntos de historia</option>
      <option value="hours">Horas estimadas restantes</option>
    </select>
  </div>
  <p id="burndown-summary" class="mt-3 text-sm font-medium"></p>
  <p id="burndown-message" class="mt-2 text-sm text-slate-600" role="status" aria-live="polite"></p>
  <div class="mt-2 h-96 rounded border bg-white p-3">
    <canvas id="burndown-chart" role="img" aria-label="Gráfica Burndown: puntos restantes reales frente a la línea ideal, con los cambios de alcance por día. Los mismos datos están en la tabla inferior."></canvas>
  </div>
  <details class="mt-4" open>
    <summary class="cursor-pointer text-sm font-semibold">Datos en tabla</summary>
    <table id="burndown-table" class="mt-2 w-full text-left text-sm">
      <caption class="sr-only">Burndown por día</caption>
      <thead>
        <tr class="border-b">
          <th scope="col" class="py-1 pr-4">Día</th>
          <th scope="col" class="py-1 pr-4">Ideal</th>
          <th scope="col" class="py-1 pr-4">Real</th>
          <th scope="col" class="py-1 pr-4">Cambio de alcance</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </details>
</div>
<script src="/vendor/chart.umd.min.js"></script>
<script src="/js/lib/chart-theme.js"></script>
<script src="/js/pages/burndown.js" defer></script>
<script src="/js/lib/live.js" defer></script>
