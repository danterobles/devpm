<h1 class="text-2xl font-bold">Matriz de asignaciones</h1>
<p class="mt-1 text-sm text-slate-600">Miembros × proyectos con asignaciones que tocan el rango.</p>

<form method="get" action="/assignments/matrix" class="mt-4 flex flex-wrap items-end gap-3">
  <div>
    <label for="from" class="block text-sm font-medium">Desde</label>
    <input id="from" name="from" type="date" value="<%= range.from %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
  </div>
  <div>
    <label for="to" class="block text-sm font-medium">Hasta</label>
    <input id="to" name="to" type="date" value="<%= range.to %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
  </div>
  <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Aplicar</button>
  <a href="/assignments/load?from=<%= range.from %>&to=<%= range.to %>" class="text-sm underline">Ver carga semanal</a>
</form>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Asignaciones por miembro y proyecto</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Miembro</th>
        <% projects.forEach((p) => { %><th scope="col" class="py-2 pr-4"><a class="underline" href="/projects/<%= p.id %>"><%= p.code %></a><span class="block text-xs font-normal text-slate-500"><%= p.name %></span></th><% }) %>
        <th scope="col" class="py-2 pr-4">Total</th>
      </tr>
    </thead>
    <tbody>
      <% members.forEach((m) => { %>
        <tr class="border-b">
          <th scope="row" class="py-2 pr-4 font-medium"><%= m.name %></th>
          <% projects.forEach((p) => { %>
            <td class="py-2 pr-4"><%= m.cells[p.id] ? `${m.cells[p.id].percent} %` : '—' %></td>
          <% }) %>
          <td class="py-2 pr-4 <%= m.totalPercent > 100 ? 'font-bold text-danger' : '' %>"><%= m.totalPercent %> %</td>
        </tr>
      <% }) %>
      <% if (members.length === 0) { %><tr><td colspan="<%= projects.length + 2 %>" class="py-3 text-slate-600">Sin asignaciones en el rango.</td></tr><% } %>
    </tbody>
  </table>
</div>
