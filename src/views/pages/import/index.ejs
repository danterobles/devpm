<%
  const field = 'mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm';
  const entity = entities[form.entity];
  const canImport = result && !result.fatal && result.total > 0 && result.errorCount === 0 && result.imported === 0;
  const preview = result && !result.fatal ? entities[result.entity].columns.slice(0, 4) : [];
%>
<h1 class="text-2xl font-bold sm:text-3xl">Importar datos</h1>
<p class="mt-1 text-sm text-slate-600">Carga clientes, miembros del equipo o tareas desde un archivo CSV. Primero se valida todo; solo se guarda si todas las filas son correctas (máximo <%= maxRows %> filas y 1 MB).</p>

<% if (done) { %>
  <p role="status" class="mt-4 rounded border border-ok bg-green-50 px-4 py-3 text-sm text-green-800">
    Se importaron <strong><%= done.count %></strong> registro(s) de «<%= entities[done.entity].label %>».
    <a class="underline" href="<%= { clients: '/clients', members: '/team', tasks: '/projects' }[done.entity] %>">Ver el resultado</a>
  </p>
<% } %>
<% if (error) { %>
  <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
<% } %>

<form method="post" action="/import" class="mt-4 space-y-4 rounded-2xl border border-navy-100 bg-white p-5 dark:border-white/10" data-import>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="entity" class="block text-sm font-medium">¿Qué vas a importar?</label>
      <select id="entity" name="entity" class="<%= field %>" data-import-entity>
        <% Object.entries(entities).forEach(([key, e]) => { %>
          <option value="<%= key %>" <%= form.entity === key ? 'selected' : '' %>><%= e.label %></option>
        <% }) %>
      </select>
      <p class="mt-1 text-sm"><a class="underline" data-import-template href="/import/template/<%= form.entity %>.csv">Descargar la plantilla</a></p>
    </div>
    <div data-import-project <%= entity.needsProject ? '' : 'hidden' %>>
      <label for="projectId" class="block text-sm font-medium">Proyecto</label>
      <select id="projectId" name="projectId" class="<%= field %>">
        <option value="">Elige un proyecto…</option>
        <% projects.forEach((p) => { %>
          <option value="<%= p.id %>" <%= String(form.projectId) === String(p.id) ? 'selected' : '' %>><%= p.code %> · <%= p.name %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <div>
    <label for="file" class="block text-sm font-medium">Archivo CSV (UTF-8, con cabecera; coma o punto y coma)</label>
    <input id="file" type="file" accept=".csv,text/csv" class="<%= field %>" data-import-file />
  </div>
  <div>
    <label for="csv" class="block text-sm font-medium">…o pega su contenido</label>
    <textarea id="csv" name="csv" rows="8" spellcheck="false" class="<%= field %> font-mono" data-import-text><%= form.csv %></textarea>
    <p id="import-message" class="mt-1 text-sm text-slate-600" role="status" aria-live="polite"></p>
  </div>

  <div class="flex flex-wrap gap-3">
    <button type="submit" name="action" value="validate" class="min-h-11 rounded-lg bg-navy-800 px-4 text-sm font-semibold text-white hover:bg-navy-700 dark:bg-sky-400 dark:text-navy-950 dark:hover:bg-sky-300">Validar</button>
    <% if (canImport) { %>
      <button type="submit" name="action" value="import" class="min-h-11 rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700">Importar <%= result.total %> fila(s)</button>
    <% } %>
  </div>
</form>

<% if (result) { %>
  <section class="mt-6 rounded-2xl border border-navy-100 bg-white p-5 dark:border-white/10" aria-labelledby="result-title">
    <h2 id="result-title" class="text-lg font-bold">Resultado de la validación</h2>
    <% if (result.fatal) { %>
      <p role="alert" class="mt-2 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= result.fatal %></p>
    <% } else { %>
      <p class="mt-2 text-sm <%= result.errorCount === 0 ? 'text-green-800' : 'text-red-700' %>" role="status">
        <%= result.total %> fila(s): <%= result.total - result.errorCount %> correcta(s), <%= result.errorCount %> con errores.
        <%= result.errorCount === 0 ? 'Ya puedes importarlas.' : 'No se guardó nada; corrige el archivo y vuelve a validar.' %>
      </p>
      <% if (result.ignoredColumns.length > 0) { %>
        <p class="mt-1 text-sm text-slate-600">Columnas ignoradas: <%= result.ignoredColumns.join(', ') %>.</p>
      <% } %>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Filas del archivo y su resultado</caption>
          <thead>
            <tr class="border-b">
              <th scope="col" class="py-2 pr-4">Línea</th>
              <th scope="col" class="py-2 pr-4">Estado</th>
              <% preview.forEach((c) => { %><th scope="col" class="py-2 pr-4"><%= c.key %></th><% }) %>
              <th scope="col" class="py-2 pr-4">Detalle</th>
            </tr>
          </thead>
          <tbody>
            <% result.rows.forEach((row) => { %>
              <tr class="border-b align-top">
                <td class="py-2 pr-4 tabular-nums"><%= row.line %></td>
                <td class="py-2 pr-4 font-semibold <%= row.errors.length === 0 ? 'text-green-800' : 'text-red-700' %>"><%= row.errors.length === 0 ? 'Correcta' : 'Con errores' %></td>
                <% preview.forEach((c) => { %><td class="py-2 pr-4"><%= row.values[c.key] %></td><% }) %>
                <td class="py-2 pr-4 text-red-700"><%= row.errors.join(' · ') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
<% } %>
<script src="/js/pages/import.js" defer></script>
