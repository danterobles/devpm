<% const field = 'mt-1 w-full rounded border border-slate-300 px-3 py-2'; %>
<section class="mx-auto max-w-md">
  <h1 class="text-2xl font-bold">Cambiar contraseña</h1>
  <% if (error) { %>
    <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
  <% } %>
  <% if (done) { %>
    <p role="status" class="mt-4 rounded border border-ok bg-green-50 px-4 py-3 text-sm text-green-800">Contraseña actualizada. Tus otras sesiones se cerraron.</p>
  <% } %>
  <form method="post" action="/account/password" class="mt-4 space-y-4">
    <div>
      <label for="currentPassword" class="block text-sm font-medium">Contraseña actual</label>
      <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password" class="<%= field %>" />
    </div>
    <div>
      <label for="newPassword" class="block text-sm font-medium">Nueva contraseña</label>
      <input id="newPassword" name="newPassword" type="password" required minlength="8" maxlength="200" autocomplete="new-password" class="<%= field %>" />
      <p class="mt-1 text-xs text-slate-600">Mínimo 8 caracteres.</p>
    </div>
    <div>
      <label for="confirmPassword" class="block text-sm font-medium">Confirmar nueva contraseña</label>
      <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password" class="<%= field %>" />
    </div>
    <button type="submit" class="rounded bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-700">Guardar</button>
  </form>
</section>
