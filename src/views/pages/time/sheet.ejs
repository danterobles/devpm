<% const dayName = ['lun', 'mar', 'mié', 'jue', 'vie', 'sáb', 'dom']; %>
<div class="flex flex-wrap items-center justify-between gap-2">
  <h1 class="text-2xl font-bold">Hoja de tiempos <span class="text-slate-500"><%= member.name %></span></h1>
  <nav class="flex items-center gap-3 text-sm" aria-label="Semana">
    <a class="underline" href="/time?week=<%= prevWeek %><%= memberQuery %>">← Semana anterior</a>
    <span><%= weekStart %> a <%= weekEnd %></span>
    <a class="underline" href="/time?week=<%= nextWeek %><%= memberQuery %>">Semana siguiente →</a>
  </nav>
</div>
<% if (error) { %>
  <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
<% } %>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Horas registradas por proyecto y día</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Proyecto</th>
        <% days.forEach((d, i) => { %><th scope="col" class="py-2 pr-3"><%= dayName[i] %> <%= d.slice(8) %></th><% }) %>
        <th scope="col" class="py-2">Total</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach((r) => { %>
        <tr class="border-b">
          <th scope="row" class="py-2 pr-4 font-medium"><%= r.projectCode %> <span class="font-normal text-slate-500"><%= r.projectName %></span></th>
          <% days.forEach((d) => { %><td class="py-2 pr-3"><%= r.cells[d] ? minutesToHours(r.cells[d]) : '—' %></td><% }) %>
          <td class="py-2 font-medium"><%= minutesToHours(r.total) %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %><tr><td colspan="9" class="py-4 text-slate-600">Sin horas registradas esta semana.</td></tr><% } %>
    </tbody>
    <tfoot>
      <tr class="border-t font-semibold">
        <th scope="row" class="py-2 pr-4">Total</th>
        <% days.forEach((d) => { %><td class="py-2 pr-3"><%= dayTotals[d] ? minutesToHours(dayTotals[d]) : '—' %></td><% }) %>
        <td class="py-2"><%= minutesToHours(total) %></td>
      </tr>
    </tfoot>
  </table>
</div>
<p class="mt-2 text-sm text-slate-600">
  Borrador: <%= statusSummary.draft %> · Enviados: <%= statusSummary.submitted %> · Aprobados: <%= statusSummary.approved %> · Rechazados: <%= statusSummary.rejected %>
</p>

<section class="mt-8" aria-labelledby="entries-title">
  <h2 id="entries-title" class="text-xl font-semibold">Registros de la semana</h2>
  <ul class="mt-3 divide-y text-sm">
    <% entries.forEach((e) => { %>
      <li class="flex flex-wrap items-center justify-between gap-2 py-2">
        <span><%= e.workDate %> · <%= e.projectCode %><% if (e.taskTitle) { %> · <%= e.taskTitle %><% } %> · <%= minutesToHours(e.minutes) %> — <%= e.description %>
          <span class="text-slate-500">(<%= e.status %><% if (e.status === 'rejected' && e.rejectionReason) { %>: <%= e.rejectionReason %><% } %>)</span></span>
        <% if (isOwn) { %><a class="underline" href="/time/entries/<%= e.id %>"><%= ['draft', 'rejected'].includes(e.status) ? 'Editar' : 'Ver' %></a><% } %>
      </li>
    <% }) %>
    <% if (entries.length === 0) { %><li class="py-2 text-slate-600">Sin registros.</li><% } %>
  </ul>
</section>

<% if (isOwn && options) { %>
  <section class="mt-8" aria-labelledby="new-entry-title">
    <h2 id="new-entry-title" class="text-xl font-semibold">Registrar horas</h2>
    <form method="post" action="/time/entries" class="mt-3 flex flex-wrap items-end gap-3">
      <div>
        <label for="projectId" class="block text-sm font-medium">Proyecto</label>
        <select id="projectId" name="projectId" required class="mt-1 rounded border border-slate-300 px-3 py-2">
          <option value="">—</option>
          <% options.projects.forEach((p) => { %><option value="<%= p.id %>" <%= String(form.projectId) === String(p.id) ? 'selected' : '' %>><%= p.code %> · <%= p.name %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="taskId" class="block text-sm font-medium">Tarea (opcional)</label>
        <select id="taskId" name="taskId" class="mt-1 rounded border border-slate-300 px-3 py-2">
          <option value="">—</option>
          <% options.projects.forEach((p) => { %>
            <optgroup label="<%= p.code %>">
              <% options.tasks.filter((t) => t.project_id === p.id).forEach((t) => { %><option value="<%= t.id %>" <%= String(form.taskId) === String(t.id) ? 'selected' : '' %>><%= t.title %></option><% }) %>
            </optgroup>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="workDate" class="block text-sm font-medium">Fecha</label>
        <input id="workDate" name="workDate" type="date" required value="<%= form.workDate || weekStart %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="hours" class="block text-sm font-medium">Horas</label>
        <input id="hours" name="hours" required inputmode="decimal" value="<%= form.hours || '' %>" class="mt-1 w-24 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="description" class="block text-sm font-medium">Descripción</label>
        <input id="description" name="description" required maxlength="500" value="<%= form.description || '' %>" class="mt-1 w-72 rounded border border-slate-300 px-3 py-2" />
      </div>
      <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Registrar</button>
    </form>
  </section>
<% } %>
