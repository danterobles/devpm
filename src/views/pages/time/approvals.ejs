<h1 class="text-2xl font-bold">Aprobaciones de tiempo</h1>
<p class="mt-1 text-sm text-slate-600">Registros enviados de los proyectos que lideras (los administradores ven todos). Los registros propios los revisa otra persona.</p>
<p class="mt-1 text-sm"><a class="underline" href="/time">← Hoja de tiempos</a></p>
<% if (error) { %>
  <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
<% } %>
<ul class="mt-4 divide-y text-sm">
  <% entries.forEach((e) => { %>
    <li class="py-3">
      <p><strong><%= e.memberName %></strong> · <%= e.projectCode %><% if (e.taskTitle) { %> · <%= e.taskTitle %><% } %> · <%= e.workDate %> · <%= minutesToHours(e.minutes) %></p>
      <p class="text-slate-600"><%= e.description %></p>
      <form method="post" action="/time/approvals/<%= e.id %>/billable" class="mt-2 flex items-center gap-2">
        <label for="billable<%= e.id %>" class="text-xs font-medium">Facturable</label>
        <select id="billable<%= e.id %>" name="isBillable" class="rounded border border-slate-300 px-2 py-1 text-xs">
          <option value="1" <%= e.isBillable ? 'selected' : '' %>>Sí</option>
          <option value="0" <%= e.isBillable ? '' : 'selected' %>>No</option>
        </select>
        <button type="submit" class="rounded border px-2 py-1 text-xs hover:bg-slate-100">Guardar</button>
      </form>
      <div class="mt-2 flex flex-wrap items-end gap-3">
        <form method="post" action="/time/approvals/<%= e.id %>/approve"><button type="submit" class="rounded bg-brand-600 px-3 py-1 text-white hover:bg-brand-700">Aprobar</button></form>
        <form method="post" action="/time/approvals/<%= e.id %>/reject" class="flex items-end gap-2">
          <div>
            <label for="reason<%= e.id %>" class="block text-xs font-medium">Motivo del rechazo</label>
            <input id="reason<%= e.id %>" name="reason" required maxlength="500" class="rounded border border-slate-300 px-2 py-1" />
          </div>
          <button type="submit" class="rounded border px-3 py-1 hover:bg-slate-100">Rechazar</button>
        </form>
      </div>
    </li>
  <% }) %>
  <% if (entries.length === 0) { %><li class="py-3 text-slate-600">No hay registros pendientes de revisión.</li><% } %>
</ul>

<% if (canExport) { %>
  <section class="mt-8" aria-labelledby="export-title">
    <h2 id="export-title" class="text-xl font-semibold">Exportar horas a CSV</h2>
    <form method="get" action="/api/v1/time-entries/export.csv" class="mt-3 flex flex-wrap items-end gap-3">
      <div>
        <label for="exFrom" class="block text-sm font-medium">Desde</label>
        <input id="exFrom" name="from" type="date" class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="exTo" class="block text-sm font-medium">Hasta</label>
        <input id="exTo" name="to" type="date" class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="exStatus" class="block text-sm font-medium">Estado</label>
        <select id="exStatus" name="status" class="mt-1 rounded border border-slate-300 px-3 py-2">
          <option value="all">Todos</option>
          <option value="approved">Aprobados</option>
          <option value="submitted">Enviados</option>
          <option value="draft">Borrador</option>
          <option value="rejected">Rechazados</option>
        </select>
      </div>
      <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Descargar CSV</button>
    </form>
  </section>
<% } %>
