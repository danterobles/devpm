<%
  const field = 'mt-1 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm';
  const ACTIONS = [['create', 'Alta'], ['update', 'Cambio'], ['delete', 'Baja'], ['status_change', 'Cambio de estado']];
%>
<%- include('../../../partials/admin-tabs', { current: 'audit' }) %>
<h1 class="text-2xl font-bold sm:text-3xl">Bitácora</h1>
<p class="mt-1 text-sm text-slate-600">Quién cambió qué y cuándo. Las contraseñas y los secretos nunca se muestran.</p>

<form method="get" action="/admin/audit" aria-label="Filtros de la bitácora" class="mt-4 grid grid-cols-2 items-end gap-3 rounded-2xl border border-navy-100 bg-white p-4 md:grid-cols-3 xl:grid-cols-6 dark:border-white/10">
  <div>
    <label for="f-entity" class="block text-xs font-semibold">Entidad</label>
    <select id="f-entity" name="entity" class="<%= field %>">
      <option value="">Todas</option>
      <% options.entities.forEach((e) => { %><option value="<%= e %>" <%= filters.entity === e ? 'selected' : '' %>><%= e %></option><% }) %>
    </select>
  </div>
  <div>
    <label for="f-action" class="block text-xs font-semibold">Acción</label>
    <select id="f-action" name="action" class="<%= field %>">
      <option value="">Todas</option>
      <% ACTIONS.forEach(([v, l]) => { %><option value="<%= v %>" <%= filters.action === v ? 'selected' : '' %>><%= l %></option><% }) %>
    </select>
  </div>
  <div>
    <label for="f-user" class="block text-xs font-semibold">Usuario</label>
    <select id="f-user" name="userId" class="<%= field %>">
      <option value="">Todos</option>
      <% options.users.forEach((u) => { %><option value="<%= u.id %>" <%= filters.userId === u.id ? 'selected' : '' %>><%= u.full_name %></option><% }) %>
    </select>
  </div>
  <div>
    <label for="f-from" class="block text-xs font-semibold">Desde</label>
    <input id="f-from" name="from" type="date" value="<%= filters.from || '' %>" class="<%= field %>" />
  </div>
  <div>
    <label for="f-to" class="block text-xs font-semibold">Hasta</label>
    <input id="f-to" name="to" type="date" value="<%= filters.to || '' %>" class="<%= field %>" />
  </div>
  <div class="flex items-center gap-3">
    <button type="submit" class="min-h-11 rounded-lg bg-navy-800 px-4 text-sm font-semibold text-white hover:bg-navy-700 dark:bg-sky-400 dark:text-navy-950 dark:hover:bg-sky-300">Filtrar</button>
    <a href="/admin/audit" class="inline-flex min-h-11 items-center text-sm underline">Limpiar</a>
  </div>
</form>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Registro de cambios</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Fecha (UTC)</th>
        <th scope="col" class="py-2 pr-4">Usuario</th>
        <th scope="col" class="py-2 pr-4">Acción</th>
        <th scope="col" class="py-2 pr-4">Entidad</th>
        <th scope="col" class="py-2 pr-4">Cambios</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach((a) => { %>
        <tr class="border-b align-top">
          <td class="py-2 pr-4 whitespace-nowrap tabular-nums"><%= a.createdAt.slice(0, 19).replace('T', ' ') %></td>
          <td class="py-2 pr-4"><%= a.userName || 'Sistema' %></td>
          <td class="py-2 pr-4"><%= a.actionLabel %></td>
          <td class="py-2 pr-4"><%= a.entityLabel %> <span class="text-slate-600">#<%= a.entityId %></span></td>
          <td class="py-2 pr-4">
            <% if (a.changes.length === 0) { %><span class="text-slate-600">—</span><% } %>
            <ul class="space-y-0.5">
              <% a.changes.forEach((c) => { %>
                <li><span class="font-medium"><%= c.field %></span>: <span class="text-slate-600"><%= c.before %></span> → <%= c.after %></li>
              <% }) %>
            </ul>
          </td>
        </tr>
      <% }) %>
      <% if (items.length === 0) { %><tr><td colspan="5" class="py-4 text-slate-600">No hay registros con estos filtros.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../../../partials/pagination', { meta, baseUrl: '/admin/audit' + (query ? '?' + query : '') }) %>
