<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Usuarios</h1>
  <a href="/admin/users/new" class="rounded bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Nuevo usuario</a>
</div>

<form method="get" action="/admin/users" class="mt-4 flex flex-wrap items-end gap-3">
  <div>
    <label for="q" class="block text-sm font-medium">Buscar</label>
    <input id="q" name="q" type="search" value="<%= query.q %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
  </div>
  <div>
    <label for="status" class="block text-sm font-medium">Estado</label>
    <select id="status" name="status" class="mt-1 rounded border border-slate-300 px-3 py-2">
      <% [['all', 'Todos'], ['active', 'Activos'], ['inactive', 'Inactivos']].forEach(([value, label]) => { %>
        <option value="<%= value %>" <%= query.status === value ? 'selected' : '' %>><%= label %></option>
      <% }) %>
    </select>
  </div>
  <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Filtrar</button>
</form>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Listado de usuarios</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Nombre</th>
        <th scope="col" class="py-2 pr-4">Correo</th>
        <th scope="col" class="py-2 pr-4">Rol</th>
        <th scope="col" class="py-2 pr-4">Estado</th>
        <th scope="col" class="py-2"><span class="sr-only">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach((u) => { %>
        <tr class="border-b">
          <td class="py-2 pr-4"><%= u.fullName %></td>
          <td class="py-2 pr-4"><%= u.email %></td>
          <td class="py-2 pr-4"><%= u.role %></td>
          <td class="py-2 pr-4"><%= u.isActive ? 'Activo' : 'Inactivo' %></td>
          <td class="py-2"><a class="underline" href="/admin/users/<%= u.id %>">Editar</a></td>
        </tr>
      <% }) %>
      <% if (users.length === 0) { %>
        <tr><td colspan="5" class="py-4 text-slate-600">No hay usuarios que coincidan.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../../partials/pagination', { meta, baseUrl }) %>
