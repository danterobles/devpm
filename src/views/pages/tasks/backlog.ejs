<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Backlog <span class="text-slate-500"><%= project.code %></span></h1>
  <p class="text-sm"><a class="underline" href="/projects/<%= project.id %>">Proyecto</a> · <a class="underline" href="/projects/<%= project.id %>/sprints">Sprints</a></p>
</div>
<% if (error) { %>
  <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
<% } %>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Tareas del backlog en orden de prioridad</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Tarea</th>
        <th scope="col" class="py-2 pr-4">Tipo</th>
        <th scope="col" class="py-2 pr-4">Prioridad</th>
        <th scope="col" class="py-2 pr-4">Puntos</th>
        <th scope="col" class="py-2 pr-4">Responsable</th>
        <th scope="col" class="py-2"><span class="sr-only">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% tasks.forEach((t) => { %>
        <tr class="border-b align-top">
          <td class="py-2 pr-4"><a class="underline" href="/tasks/<%= t.id %>"><%= t.title %></a><% if (t.subtaskCount > 0) { %> <span class="text-xs text-slate-500">(<%= t.subtaskCount %> subtareas)</span><% } %></td>
          <td class="py-2 pr-4"><%= t.type %></td>
          <td class="py-2 pr-4"><%= t.priority %></td>
          <td class="py-2 pr-4"><%= t.storyPoints ?? '—' %></td>
          <td class="py-2 pr-4"><%= t.assigneeName || '—' %></td>
          <td class="py-2">
            <% if (canWrite) { %>
              <div class="flex flex-wrap items-center gap-2">
                <form method="post" action="/projects/<%= project.id %>/backlog/<%= t.id %>/move"><button type="submit" name="direction" value="up" class="underline" aria-label="Subir <%= t.title %>">Subir</button></form>
                <form method="post" action="/projects/<%= project.id %>/backlog/<%= t.id %>/move"><button type="submit" name="direction" value="down" class="underline" aria-label="Bajar <%= t.title %>">Bajar</button></form>
                <% if (sprints.length > 0) { %>
                  <form method="post" action="/projects/<%= project.id %>/backlog/<%= t.id %>/sprint" class="flex items-center gap-1">
                    <label for="sp<%= t.id %>" class="sr-only">Sprint destino de <%= t.title %></label>
                    <select id="sp<%= t.id %>" name="sprintId" class="rounded border border-slate-300 px-2 py-1">
                      <% sprints.forEach((s) => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
                    </select>
                    <button type="submit" class="underline">Enviar</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (tasks.length === 0) { %><tr><td colspan="6" class="py-4 text-slate-600">El backlog está vacío.</td></tr><% } %>
    </tbody>
  </table>
</div>

<% if (canWrite) { %>
  <section class="mt-8" aria-labelledby="new-task-title">
    <h2 id="new-task-title" class="text-xl font-semibold">Nueva tarea</h2>
    <form method="post" action="/projects/<%= project.id %>/backlog" class="mt-3 flex flex-wrap items-end gap-3">
      <div>
        <label for="tkTitle" class="block text-sm font-medium">Título</label>
        <input id="tkTitle" name="title" required maxlength="200" value="<%= form.title || '' %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="tkType" class="block text-sm font-medium">Tipo</label>
        <select id="tkType" name="type" class="mt-1 rounded border border-slate-300 px-3 py-2">
          <% types.forEach((t) => { %><option value="<%= t %>" <%= form.type === t ? 'selected' : '' %>><%= t %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="tkPriority" class="block text-sm font-medium">Prioridad</label>
        <select id="tkPriority" name="priority" class="mt-1 rounded border border-slate-300 px-3 py-2">
          <% priorities.forEach((p) => { %><option value="<%= p %>" <%= (form.priority || 'medium') === p ? 'selected' : '' %>><%= p %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="tkPoints" class="block text-sm font-medium">Puntos</label>
        <select id="tkPoints" name="storyPoints" class="mt-1 rounded border border-slate-300 px-3 py-2">
          <option value="">—</option>
          <% points.forEach((p) => { %><option value="<%= p %>" <%= String(form.storyPoints) === String(p) ? 'selected' : '' %>><%= p %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="tkHours" class="block text-sm font-medium">Estimación (h)</label>
        <input id="tkHours" name="estimatedHours" inputmode="decimal" value="<%= form.estimatedHours || '' %>" class="mt-1 w-24 rounded border border-slate-300 px-3 py-2" />
      </div>
      <div>
        <label for="tkAssignee" class="block text-sm font-medium">Responsable</label>
        <select id="tkAssignee" name="assigneeId" class="mt-1 rounded border border-slate-300 px-3 py-2">
          <option value="">—</option>
          <% members.forEach((m) => { %><option value="<%= m.id %>" <%= String(form.assigneeId) === String(m.id) ? 'selected' : '' %>><%= m.name %></option><% }) %>
        </select>
      </div>
      <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Agregar</button>
    </form>
  </section>
<% } %>
