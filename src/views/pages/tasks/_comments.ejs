<% if (comments) { %>
<section id="comentarios" class="mt-10" aria-labelledby="comments-title" data-comments data-live data-live-project="<%= task.projectId %>" data-live-types="comment.">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="comments-title" class="text-xl font-semibold">Comentarios <span class="text-base font-medium text-slate-600">(<%= comments.items.length %>)</span></h2>
    <p data-live-status class="text-xs text-slate-600" role="status" aria-live="polite"></p>
  </div>
  <ul class="mt-3 space-y-3">
    <% comments.items.forEach((c) => { %>
      <li class="rounded-xl border border-navy-100 bg-white p-4 dark:border-white/10" id="comentario-<%= c.id %>">
        <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
          <p><span class="font-semibold"><%= c.authorName %></span>
            <span class="text-slate-600">· <%= c.createdAt.slice(0, 16).replace('T', ' ') %> UTC<% if (c.isEdited) { %> · editado<% } %></span></p>
          <% if (c.canDelete) { %>
            <form method="post" action="/comments/<%= c.id %>/delete"><button type="submit" class="min-h-11 px-2 underline">Eliminar</button></form>
          <% } %>
        </div>
        <p class="mt-2 whitespace-pre-line break-words text-sm"><%= c.body %></p>
        <% if (c.canEdit && comments.canComment) { %>
          <details class="mt-2 text-sm">
            <summary class="min-h-11 cursor-pointer underline">Editar</summary>
            <form method="post" action="/comments/<%= c.id %>" class="mt-2 space-y-2">
              <label for="edit-<%= c.id %>" class="sr-only">Editar comentario</label>
              <textarea id="edit-<%= c.id %>" name="body" rows="3" required maxlength="4000" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"><%= c.body %></textarea>
              <button type="submit" class="min-h-11 rounded-lg border px-4 py-2 hover:bg-slate-100">Guardar cambios</button>
            </form>
          </details>
        <% } %>
      </li>
    <% }) %>
    <% if (comments.items.length === 0) { %><li class="text-sm text-slate-600">Aún no hay comentarios.</li><% } %>
  </ul>
  <% if (comments.canComment) { %>
    <form method="post" action="/tasks/<%= task.id %>/comments" class="mt-4 space-y-2">
      <label for="new-comment" class="block text-sm font-medium">Nuevo comentario</label>
      <textarea id="new-comment" name="body" rows="3" required maxlength="4000" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></textarea>
      <p class="text-xs text-slate-600">Para avisar a alguien, escribe @ y su correo completo (p. ej. @ana@empresa.com).</p>
      <button type="submit" class="min-h-11 rounded-lg bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-700">Comentar</button>
    </form>
  <% } else { %>
    <p class="mt-4 text-sm text-slate-600">Solo el equipo asignado al proyecto puede comentar.</p>
  <% } %>
</section>
<script src="/js/lib/live.js" defer></script>
<script src="/js/pages/comments.js" defer></script>
<% } %>
