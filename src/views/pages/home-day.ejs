<%
  const card = 'rounded-2xl border border-navy-100 bg-white p-5 dark:border-white/10';
  const h2 = 'text-lg font-bold';
  const link = 'font-semibold underline decoration-navy-300 underline-offset-2 hover:decoration-2';
  const muted = 'text-sm text-slate-600';
  const STATUS = { todo: 'Por hacer', in_progress: 'En progreso', in_review: 'En revisión', blocked: 'Bloqueada' };
  const first = fullName.split(' ')[0];
%>
<div data-home data-live data-live-types="task.,time_entry.,milestone.,project.,notification.">
  <div class="flex flex-wrap items-end justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold sm:text-3xl">Hola, <%= first %></h1>
      <p class="mt-1 text-sm text-slate-600">Tu día, <%= panel.today %>.</p>
    </div>
    <p data-live-status class="text-xs text-slate-600" role="status" aria-live="polite"></p>
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-2">

    <% if (panel.mine) { %>
      <section class="<%= card %>" aria-labelledby="week-title">
        <h2 id="week-title" class="<%= h2 %>">Tus horas de la semana</h2>
        <p class="mt-2 text-3xl font-bold tabular-nums"><%= panel.mine.week.loggedHours %> h <span class="text-base font-medium text-slate-600">de <%= panel.mine.week.capacityHours %> h</span></p>
        <% if (panel.mine.week.percent !== null) { %>
          <div class="mt-3 h-2 overflow-hidden rounded-full bg-navy-100 dark:bg-navy-800" role="img" aria-label="<%= panel.mine.week.percent %> % de tu capacidad semanal">
            <div class="h-full rounded-full bg-navy-700 dark:bg-sky-400" style="width: <%= Math.min(100, panel.mine.week.percent) %>%"></div>
          </div>
        <% } %>
        <p class="<%= muted %> mt-3"><%= panel.mine.week.toSend %> sin enviar · <%= panel.mine.week.submitted %> enviados</p>
        <p class="mt-3"><a class="<%= link %>" href="/time">Ir a la hoja de tiempos</a></p>
        <% if (panel.mine.rejected.length > 0) { %>
          <h3 class="mt-4 text-sm font-bold">Rechazadas por corregir</h3>
          <ul class="mt-1 divide-y divide-navy-100 text-sm dark:divide-white/10">
            <% panel.mine.rejected.forEach((r) => { %>
              <li class="py-2"><a class="<%= link %>" href="/time/entries/<%= r.id %>"><%= r.project_code %> · <%= r.work_date %> · <%= r.hours %> h</a><span class="block text-slate-600">Motivo: <%= r.reason %></span></li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="<%= card %>" aria-labelledby="tasks-title">
        <h2 id="tasks-title" class="<%= h2 %>">Tus tareas abiertas</h2>
        <ul class="mt-2 divide-y divide-navy-100 text-sm dark:divide-white/10">
          <% panel.mine.tasks.forEach((t) => { %>
            <li class="flex flex-wrap items-center justify-between gap-2 py-2">
              <span class="min-w-0"><a class="<%= link %>" href="/tasks/<%= t.id %>"><%= t.title %></a>
                <span class="block text-slate-600"><%= t.project_code %> · <%= STATUS[t.status] %><% if (t.due_date) { %> · vence <%= t.due_date %><% } %></span></span>
              <% if (t.overdue) { %><span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-800 dark:bg-rose-500/20 dark:text-rose-200">Vencida</span><% } %>
            </li>
          <% }) %>
          <% if (panel.mine.tasks.length === 0) { %><li class="py-2 text-slate-600">No tienes tareas abiertas asignadas.</li><% } %>
        </ul>
      </section>
    <% } %>

    <% if (panel.lead) { %>
      <section class="<%= card %>" aria-labelledby="approvals-title">
        <h2 id="approvals-title" class="<%= h2 %>">Horas por aprobar</h2>
        <p class="mt-2 text-3xl font-bold tabular-nums"><%= panel.lead.pendingApprovals %></p>
        <p class="mt-3"><a class="<%= link %>" href="/time/approvals">Revisar aprobaciones</a></p>
      </section>

      <section class="<%= card %>" aria-labelledby="risk-title">
        <h2 id="risk-title" class="<%= h2 %>">Proyectos en riesgo</h2>
        <ul class="mt-2 divide-y divide-navy-100 text-sm dark:divide-white/10">
          <% panel.lead.risk.forEach((p) => { %>
            <li class="py-2"><a class="<%= link %>" href="/projects/<%= p.id %>"><%= p.code %> · <%= p.name %></a>
              <span class="block text-slate-600"><%= p.causes.join(' · ') %></span></li>
          <% }) %>
          <% if (panel.lead.risk.length === 0) { %><li class="py-2 text-slate-600">Ningún proyecto está en riesgo.</li><% } %>
        </ul>
      </section>

      <section class="<%= card %>" aria-labelledby="milestones-title">
        <h2 id="milestones-title" class="<%= h2 %>">Hitos vencidos o próximos (7 días)</h2>
        <ul class="mt-2 divide-y divide-navy-100 text-sm dark:divide-white/10">
          <% panel.lead.milestones.forEach((m) => { %>
            <li class="flex flex-wrap items-center justify-between gap-2 py-2">
              <span><a class="<%= link %>" href="/projects/<%= m.project_id %>"><%= m.name %></a>
                <span class="block text-slate-600"><%= m.project_code %> · <%= m.due_date %></span></span>
              <% if (m.overdue) { %><span class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-800 dark:bg-rose-500/20 dark:text-rose-200">Vencido</span><% } %>
            </li>
          <% }) %>
          <% if (panel.lead.milestones.length === 0) { %><li class="py-2 text-slate-600">Sin hitos por atender.</li><% } %>
        </ul>
      </section>

      <section class="<%= card %>" aria-labelledby="blocked-title">
        <h2 id="blocked-title" class="<%= h2 %>">Tareas bloqueadas</h2>
        <ul class="mt-2 divide-y divide-navy-100 text-sm dark:divide-white/10">
          <% panel.lead.blocked.forEach((t) => { %>
            <li class="py-2"><a class="<%= link %>" href="/tasks/<%= t.id %>"><%= t.title %></a> <span class="text-slate-600">· <%= t.project_code %></span></li>
          <% }) %>
          <% if (panel.lead.blocked.length === 0) { %><li class="py-2 text-slate-600">No hay tareas bloqueadas.</li><% } %>
        </ul>
      </section>
    <% } %>

    <% if (panel.projects) { %>
      <section class="<%= card %> lg:col-span-2" aria-labelledby="projects-title">
        <h2 id="projects-title" class="<%= h2 %>">Proyectos activos</h2>
        <ul class="mt-2 grid gap-3 sm:grid-cols-2">
          <% panel.projects.forEach((p) => { %>
            <li class="rounded-xl bg-navy-50 p-3 dark:bg-navy-950">
              <a class="<%= link %>" href="/projects/<%= p.id %>"><%= p.code %> · <%= p.name %></a>
              <p class="<%= muted %>">Fin planeado <%= p.end_date %> · avance <%= p.percent === null ? '—' : p.percent + ' %' %></p>
            </li>
          <% }) %>
          <% if (panel.projects.length === 0) { %><li class="text-slate-600">No hay proyectos activos.</li><% } %>
        </ul>
        <p class="mt-3"><a class="<%= link %>" href="/dashboard">Ir al tablero de KPIs</a></p>
      </section>
    <% } %>

    <section class="<%= card %> lg:col-span-2" aria-labelledby="notif-title">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="notif-title" class="<%= h2 %>">Notificaciones sin leer <span class="text-base font-medium text-slate-600">(<%= panel.unreadTotal %>)</span></h2>
        <a class="<%= link %> text-sm" href="/notifications">Ver todas</a>
      </div>
      <ul class="mt-2 divide-y divide-navy-100 text-sm dark:divide-white/10">
        <% panel.notifications.forEach((n) => { %>
          <li class="py-2"><span class="font-semibold"><%= n.title %></span> <span class="text-slate-600">— <%= n.body %></span></li>
        <% }) %>
        <% if (panel.notifications.length === 0) { %><li class="py-2 text-slate-600">Estás al día.</li><% } %>
      </ul>
    </section>
  </div>

  <p class="mt-6 text-sm"><a class="<%= link %>" href="/dashboard">Ir al tablero de KPIs</a></p>
</div>
<script src="/js/lib/live.js" defer></script>
<script src="/js/pages/home.js" defer></script>
