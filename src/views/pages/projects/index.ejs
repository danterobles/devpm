<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Proyectos</h1>
  <% if (canWrite) { %>
    <a href="/projects/new" class="rounded bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700">Nuevo proyecto</a>
  <% } %>
</div>

<form method="get" action="/projects" class="mt-4 flex flex-wrap items-end gap-3">
  <div>
    <label for="q" class="block text-sm font-medium">Buscar</label>
    <input id="q" name="q" type="search" value="<%= query.q %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
  </div>
  <div>
    <label for="status" class="block text-sm font-medium">Estado</label>
    <select id="status" name="status" class="mt-1 rounded border border-slate-300 px-3 py-2">
      <option value="all">Todos</option>
      <% statuses.forEach((s) => { %><option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </div>
  <div>
    <label for="priority" class="block text-sm font-medium">Prioridad</label>
    <select id="priority" name="priority" class="mt-1 rounded border border-slate-300 px-3 py-2">
      <option value="all">Todas</option>
      <% priorities.forEach((p) => { %><option value="<%= p %>" <%= query.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
    </select>
  </div>
  <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Filtrar</button>
</form>
<%- include('../../partials/saved-filters', { scope: 'projects', basePath: '/projects', projectId: null }) %>

<div class="mt-4 overflow-x-auto">
  <table class="w-full text-left text-sm">
    <caption class="sr-only">Proyectos</caption>
    <thead>
      <tr class="border-b">
        <th scope="col" class="py-2 pr-4">Código</th>
        <th scope="col" class="py-2 pr-4">Nombre</th>
        <th scope="col" class="py-2 pr-4">Cliente</th>
        <th scope="col" class="py-2 pr-4">Líder</th>
        <th scope="col" class="py-2 pr-4">Estado</th>
        <th scope="col" class="py-2 pr-4">Prioridad</th>
        <th scope="col" class="py-2 pr-4">Periodo</th>
        <th scope="col" class="py-2"><span class="sr-only">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% projects.forEach((p) => { %>
        <tr class="border-b">
          <td class="py-2 pr-4"><%= p.code %></td>
          <td class="py-2 pr-4"><%= p.name %></td>
          <td class="py-2 pr-4"><%= p.clientName %></td>
          <td class="py-2 pr-4"><%= p.managerName || '—' %></td>
          <td class="py-2 pr-4"><%= p.status %></td>
          <td class="py-2 pr-4"><%= p.priority %></td>
          <td class="py-2 pr-4"><%= p.startDate %> → <%= p.endDate %></td>
          <td class="py-2"><a class="underline" href="/projects/<%= p.id %>"><%= canWrite ? 'Editar' : 'Ver' %></a></td>
        </tr>
      <% }) %>
      <% if (projects.length === 0) { %>
        <tr><td colspan="8" class="py-4 text-slate-600">No hay proyectos que coincidan.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../../partials/pagination', { meta, baseUrl }) %>
