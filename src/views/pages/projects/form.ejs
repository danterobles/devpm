<% const action = editing ? `/projects/${project.id}` : '/projects'; %>
<% const field = 'mt-1 w-full rounded border border-slate-300 px-3 py-2'; %>
<% const ro = canWrite ? '' : 'readonly disabled'; %>
<% const v = (key) => (project[key] === null || project[key] === undefined ? '' : project[key]); %>
<% const clientLocked = editing && project.status !== 'planning'; %>
<section class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-bold"><%= title %><% if (editing) { %> <span class="text-slate-500"><%= project.code %></span><% } %></h1>
  <% if (editing) { %><p class="mt-1 text-sm text-slate-600">Estado: <%= project.status %></p><% } %>
  <% if (editing && summary) { %>
    <% const hrs = (m) => `${(m / 60).toFixed(1)} h`; %>
    <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4" aria-label="Resumen del proyecto">
      <div class="rounded border p-3"><dt class="text-slate-600">Cliente</dt><dd class="font-medium"><%= project.clientName %></dd></div>
      <div class="rounded border p-3"><dt class="text-slate-600">Líder</dt><dd class="font-medium"><%= project.managerName || '—' %></dd></div>
      <div class="rounded border p-3"><dt class="text-slate-600">Horas consumidas</dt><dd class="font-medium"><%= hrs(summary.consumedMinutes) %> de <%= hrs(summary.budgetMinutes) %><% if (summary.budgetUsedPercent !== null) { %> (<%= summary.budgetUsedPercent %> %)<% } %></dd></div>
      <div class="rounded border p-3"><dt class="text-slate-600">Horas facturables</dt><dd class="font-medium"><%= hrs(summary.billableMinutes) %></dd></div>
      <div class="rounded border p-3"><dt class="text-slate-600">Miembros asignados</dt><dd class="font-medium"><%= summary.assignedMembers %></dd></div>
      <div class="rounded border p-3"><dt class="text-slate-600">Hitos completados</dt><dd class="font-medium"><%= summary.milestonesCompleted %> de <%= summary.milestonesTotal %></dd></div>
      <div class="rounded border p-3"><dt class="text-slate-600">Inicio real</dt><dd class="font-medium"><%= project.actualStartDate || '—' %></dd></div>
      <div class="rounded border p-3"><dt class="text-slate-600">Fin real</dt><dd class="font-medium"><%= project.actualEndDate || '—' %></dd></div>
    </dl>
  <% } %>
  <% if (error) { %>
    <p role="alert" class="mt-4 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
  <% } %>
  <form method="post" action="<%= action %>" class="mt-4 space-y-4">
    <div>
      <label for="name" class="block text-sm font-medium">Nombre</label>
      <input id="name" name="name" required maxlength="150" value="<%= v('name') %>" <%= ro %> class="<%= field %>" />
    </div>
    <div>
      <label for="description" class="block text-sm font-medium">Descripción</label>
      <textarea id="description" name="description" rows="3" maxlength="2000" <%= ro %> class="<%= field %>"><%= v('description') %></textarea>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="clientId" class="block text-sm font-medium">Cliente</label>
        <select id="clientId" name="clientId" required <%= (clientLocked || !canWrite) ? 'disabled' : '' %> class="<%= field %>">
          <option value="">—</option>
          <% options.clients.forEach((c) => { %>
            <option value="<%= c.id %>" <%= String(project.clientId ?? project.clientId) === String(c.id) ? 'selected' : '' %>><%= c.name %> (<%= c.type === 'internal' ? 'interno' : 'externo' %>)</option>
          <% }) %>
          <% if (editing && !options.clients.some((c) => c.id === project.clientId)) { %>
            <option value="<%= project.clientId %>" selected><%= project.clientName %></option>
          <% } %>
        </select>
      </div>
      <div>
        <label for="managerId" class="block text-sm font-medium">Líder</label>
        <select id="managerId" name="managerId" <%= ro %> class="<%= field %>">
          <option value="">Sin líder</option>
          <% options.members.forEach((m) => { %>
            <option value="<%= m.id %>" <%= String(v('managerId')) === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="priority" class="block text-sm font-medium">Prioridad</label>
        <select id="priority" name="priority" <%= ro %> class="<%= field %>">
          <% priorities.forEach((p) => { %><option value="<%= p %>" <%= project.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
        </select>
      </div>
      <div>
        <label for="methodology" class="block text-sm font-medium">Metodología</label>
        <select id="methodology" name="methodology" <%= ro %> class="<%= field %>">
          <% methodologies.forEach((m) => { %><option value="<%= m %>" <%= project.methodology === m ? 'selected' : '' %>><%= m %></option><% }) %>
        </select>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="startDate" class="block text-sm font-medium">Inicio planeado</label>
        <input id="startDate" name="startDate" type="date" required value="<%= v('startDate') %>" <%= ro %> class="<%= field %>" />
      </div>
      <div>
        <label for="endDate" class="block text-sm font-medium">Fin planeado</label>
        <input id="endDate" name="endDate" type="date" required value="<%= v('endDate') %>" <%= ro %> class="<%= field %>" />
      </div>
    </div>
    <div class="grid grid-cols-3 gap-4">
      <div>
        <label for="budgetHours" class="block text-sm font-medium">Presupuesto (horas)</label>
        <input id="budgetHours" name="budgetHours" required inputmode="decimal" pattern="\d+(\.\d{1,2})?" value="<%= v('budgetHours') %>" <%= ro %> class="<%= field %>" />
      </div>
      <div>
        <label for="budgetAmount" class="block text-sm font-medium">Presupuesto (monto)</label>
        <input id="budgetAmount" name="budgetAmount" inputmode="decimal" pattern="\d+(\.\d{1,2})?" value="<%= v('budgetAmount') %>" <%= ro %> class="<%= field %>" />
      </div>
      <div>
        <label for="isBillable" class="block text-sm font-medium">Facturable</label>
        <select id="isBillable" name="isBillable" <%= ro %> class="<%= field %>">
          <% if (!editing) { %><option value="">Según el cliente</option><% } %>
          <option value="1" <%= v('isBillable') === '1' ? 'selected' : '' %>>Sí</option>
          <option value="0" <%= v('isBillable') === '0' ? 'selected' : '' %>>No</option>
        </select>
      </div>
    </div>
    <div class="flex gap-3">
      <% if (canWrite) { %>
        <button type="submit" class="rounded bg-brand-600 px-4 py-2 font-medium text-white hover:bg-brand-700">Guardar</button>
      <% } %>
      <a href="/projects" class="rounded border px-4 py-2 hover:bg-slate-100"><%= canWrite ? 'Cancelar' : 'Volver' %></a>
    </div>
  </form>

  <% if (editing && canWrite && transitions.length > 0) { %>
    <section class="mt-10" aria-labelledby="status-title">
      <h2 id="status-title" class="text-xl font-semibold">Cambiar estado</h2>
      <% if (statusError) { %>
        <p role="alert" class="mt-3 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= statusError %></p>
      <% } %>
      <form method="post" action="/projects/<%= project.id %>/status" class="mt-3 space-y-3">
        <% if (transitions.includes('completed')) { %>
          <div class="flex items-center gap-2">
            <input id="confirmOpenTasks" name="confirmOpenTasks" type="checkbox" value="1" />
            <label for="confirmOpenTasks" class="text-sm">Completar aunque queden tareas abiertas</label>
          </div>
        <% } %>
        <div class="flex flex-wrap gap-3">
          <% transitions.forEach((t) => { %>
            <button type="submit" name="status" value="<%= t %>" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Pasar a <%= t %></button>
          <% }) %>
        </div>
      </form>
    </section>
  <% } %>

  <% if (editing) { %>
    <section class="mt-10" aria-labelledby="milestones-title">
      <h2 id="milestones-title" class="text-xl font-semibold">Hitos</h2>
      <% if (milestoneError) { %>
        <p role="alert" class="mt-3 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= milestoneError %></p>
      <% } %>
      <ul class="mt-3 divide-y text-sm">
        <% milestones.forEach((m) => { %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <span><%= m.dueDate %> — <%= m.name %> <span class="text-slate-500">(<%= m.status %>)</span><% if (m.description) { %> — <%= m.description %><% } %></span>
            <% if (canWrite) { %>
              <span class="flex gap-3">
                <% milestoneStatuses.filter((s) => s !== m.status).forEach((s) => { %>
                  <form method="post" action="/projects/<%= project.id %>/milestones/<%= m.id %>/status">
                    <button type="submit" name="status" value="<%= s %>" class="underline">Marcar <%= s %></button>
                  </form>
                <% }) %>
                <form method="post" action="/projects/<%= project.id %>/milestones/<%= m.id %>/delete">
                  <button type="submit" class="underline" aria-label="Eliminar hito <%= m.name %>">Eliminar</button>
                </form>
              </span>
            <% } %>
          </li>
        <% }) %>
        <% if (milestones.length === 0) { %><li class="py-2 text-slate-600">Sin hitos registrados.</li><% } %>
      </ul>
      <% if (canWrite) { %>
        <form method="post" action="/projects/<%= project.id %>/milestones" class="mt-4 flex flex-wrap items-end gap-3">
          <div>
            <label for="msName" class="block text-sm font-medium">Hito</label>
            <input id="msName" name="name" required maxlength="150" class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="msDue" class="block text-sm font-medium">Fecha compromiso</label>
            <input id="msDue" name="dueDate" type="date" required class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="msDesc" class="block text-sm font-medium">Descripción</label>
            <input id="msDesc" name="description" maxlength="1000" class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Agregar</button>
        </form>
      <% } %>
    </section>
  <% } %>

  <% if (editing) { %>
    <section class="mt-10" aria-labelledby="assignments-title">
      <h2 id="assignments-title" class="text-xl font-semibold">Equipo asignado</h2>
      <% if (warning === 'over-allocation') { %>
        <p role="status" class="mt-3 rounded border border-warn bg-amber-50 px-4 py-3 text-sm text-amber-900">La asignación se guardó, pero el miembro queda sobreasignado (más de 100 %) en ese periodo.</p>
      <% } %>
      <% if (assignmentError) { %>
        <p role="alert" class="mt-3 rounded border border-danger bg-red-50 px-4 py-3 text-sm text-red-800"><%= assignmentError %></p>
      <% } %>
      <ul class="mt-3 divide-y text-sm">
        <% assignments.forEach((a) => { %>
          <li class="flex items-center justify-between py-2">
            <span><%= a.memberName %> — <%= a.projectRole %> (<%= a.allocationPercent %> %), <%= a.startDate %> a <%= a.endDate %></span>
            <% if (canWrite) { %>
              <form method="post" action="/projects/<%= project.id %>/assignments/<%= a.id %>/delete">
                <button type="submit" class="underline" aria-label="Quitar a <%= a.memberName %>">Quitar</button>
              </form>
            <% } %>
          </li>
        <% }) %>
        <% if (assignments.length === 0) { %><li class="py-2 text-slate-600">Sin miembros asignados.</li><% } %>
      </ul>
      <% if (canWrite) { %>
        <form method="post" action="/projects/<%= project.id %>/assignments" class="mt-4 flex flex-wrap items-end gap-3">
          <div>
            <label for="asgMember" class="block text-sm font-medium">Miembro</label>
            <select id="asgMember" name="teamMemberId" required class="mt-1 rounded border border-slate-300 px-3 py-2">
              <option value="">—</option>
              <% options.members.forEach((m) => { %><option value="<%= m.id %>"><%= m.name %></option><% }) %>
            </select>
          </div>
          <div>
            <label for="asgRole" class="block text-sm font-medium">Rol en el proyecto</label>
            <input id="asgRole" name="projectRole" required maxlength="80" class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="asgPct" class="block text-sm font-medium">Dedicación (%)</label>
            <input id="asgPct" name="allocationPercent" type="number" min="1" max="100" required class="mt-1 w-24 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="asgStart" class="block text-sm font-medium">Desde</label>
            <input id="asgStart" name="startDate" type="date" required value="<%= project.startDate %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <div>
            <label for="asgEnd" class="block text-sm font-medium">Hasta</label>
            <input id="asgEnd" name="endDate" type="date" required value="<%= project.endDate %>" class="mt-1 rounded border border-slate-300 px-3 py-2" />
          </div>
          <button type="submit" class="rounded border px-4 py-2 text-sm hover:bg-slate-100">Asignar</button>
        </form>
      <% } %>
    </section>
  <% } %>
</section>
